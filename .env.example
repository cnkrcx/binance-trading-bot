# Bu dosyayı ".env" olarak kopyala ve kendi bilgilerinle doldur.
# .env dosyasını ASLA paylaşma veya Git'e (GitHub vb.) yükleme!

# Binance TESTNET API bilgileri
# Almak için: https://testnet.binance.vision/ adresine git, GitHub hesabınla giriş yap,
# "Generate HMAC_SHA256 Key" ile bir anahtar oluştur.
BINANCE_API_KEY=buraya_testnet_api_key_yaz
BINANCE_API_SECRET=buraya_testnet_api_secret_yaz

# true = Testnet (sahte para), false = Gerçek hesap (GERÇEK PARA, dikkatli ol!)
USE_TESTNET=true

# --- Strateji ve Risk Ayarları ---
# Taranacak minimum 24 saatlik USDT hacmi (düşük hacimli/riskli coinleri elemek için)
MIN_24H_VOLUME_USDT=5000000

# Aynı anda açık tutulabilecek maksimum pozisyon sayısı
MAX_OPEN_POSITIONS=5

# Her işlemde bakiyenin yüzde kaçı kullanılsın (0.10 = %10)
POSITION_SIZE_PCT=0.10

# Stop-loss ve take-profit yüzdeleri (yaklaşık 2:1 kâr/risk oranı).
# Not: Binance spot komisyonu işlem başına ~%0.1 (BNB ile ödersen ~%0.075),
# yani bir alım+satım ~%0.15-0.2 komisyon demektir - çok sık işlem açmamak
# (bkz. MIN_MINUTES_BETWEEN_TRADES) bu yüzden önemlidir.
STOP_LOSS_PCT=0.015

# TAKE_PROFIT_PCT bir TAVAN değil, MİNİMUM kâr hedefidir. Fiyat buraya
# ulaşınca bot hemen satmaz, "iz süren stop" (trailing stop) moduna geçer:
# fiyat yükselmeye devam ettikçe zirveyi (ve zirvedeki kâr yüzdesini) takip
# eder. Çıkış sabit bir fiyat düşüşüne değil, zirvedeki KÂRIN YÜZDESİNE göre
# tetiklenir: o kârın PROFIT_GIVEBACK_TRAIL_PCT kadarı geri verilirse satılır.
# Böylece büyük bir yükselişte nefes payı tanınır, ama ne kadar kâr edilmiş
# olursa olsun en az yarısı (varsayılan %50) her zaman kilitlenir.
TAKE_PROFIT_PCT=0.03
PROFIT_GIVEBACK_TRAIL_PCT=0.5

# Borsa komisyon oranı (alım/satım ayrı ayrı alınır, ör. Binance standart %0.1).
# Gerçekçi net kâr/zarar görmek için PnL hesaplarına her zaman uygulanır
# (testnet dahil - amaç gerçek hesapta beklenen sonucu önceden görebilmek).
TRADING_FEE_PCT=0.001

# Bir parite SATILDIKTAN sonra AYNI parite en az bu kadar dakika tekrar
# alınamaz (hangi coin olursa olsun) - art arda aynı coine dönüp aynı hataya
# düşmemek için.
SAME_SYMBOL_COOLDOWN_MINUTES=60

# Günlük maksimum zarar yüzdesi - bu seviyeye ulaşınca bot o gün işlem yapmayı durdurur
DAILY_MAX_LOSS_PCT=0.05

# Gün içinde ulaşılan en yüksek kârın bu oranı kadarı geri verilirse
# (ör. gün +100 USDT oldu, sonra +60'a geriledi = %40 geri verildi) bot o
# gün için yeni işlem açmayı durdurur - kalan kârı korumak için.
PROFIT_GIVEBACK_LIMIT_PCT=0.40

# Tam piyasa + haber taraması ne sıklıkla yapılsın (dakika). Sık taramak hem
# gereksiz LLM/API maliyeti hem de daha fazla işlem -> daha fazla komisyon
# demektir; bu yüzden yüksek tutulması öneriliyor.
SCAN_INTERVAL_MINUTES=180

# Açık pozisyonların stop-loss/take-profit/kâr koruması kontrolü (fiyat
# izleme) bundan bağımsız, çok daha sık yapılır - saniye cinsinden.
POSITION_CHECK_INTERVAL_SECONDS=60

# Yeni bir işlem açıldıktan sonra en az bu kadar dakika geçmeden başka yeni
# işlem AÇILMAZ. Komisyonların küçük hedef kârı eritmesini önlemek için.
MIN_MINUTES_BETWEEN_TRADES=120

# Bir paritenin satın alınabilmesi için fırsat skorunun (0-100) en az bu
# değere ulaşması gerekir. Düşürmek daha sık ama daha düşük kaliteli işlem demektir.
MIN_OPPORTUNITY_SCORE=60

# Analiz için kullanılacak mum zaman dilimi (1h, 4h, 1d vb.)
KLINE_INTERVAL=1h

# --- Haber / Duygu Analizi (sentiment.py, news_sentiment.py) ---
# Bir LLM API anahtarı (ör. https://console.anthropic.com/ üzerinden) girersen
# haberler gerçek dil anlayışıyla analiz edilir. Boş bırakılırsa bot otomatik
# olarak ÜCRETSİZ anahtar-kelime tabanlı analize geçer (bkz. sentiment.py) -
# hiçbir durumda "duygu analizi yok" haline düşmez.
ANTHROPIC_API_KEY=
SENTIMENT_MODEL=claude-haiku-4-5-20251001

# Haber/duyuru RSS kaynakları (virgülle ayrılmış) - resmi kaynaklar (SEC, Fed)
# ve önde gelen kripto haber siteleri (altcoin kapsamı için). X (Twitter)
# API'si ücretli olduğu için dahil edilmedi; istersen bulduğun ek kaynakları
# buraya virgülle ekleyebilirsin.
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.sec.gov/news/pressreleases.rss,https://www.federalreserve.gov/feeds/press_all.xml,https://cryptoslate.com/feed/,https://decrypt.co/feed,https://u.today/rss,https://cryptopotato.com/feed/,https://ambcrypto.com/feed/,https://beincrypto.com/feed/,https://dailyhodl.com/feed/

# Bir haberin duygu skoru bu eşiğin altındaysa (-1 ile 1 arası, çok olumsuz:
# hack/dava/yasak vb.) o parite teknik skoru ne olursa olsun elenir.
NEGATIVE_SENTIMENT_VETO=-0.5

# RSI bu değerin üzerindeyse (aşırı-aşırı alım) parite diğer göstergeler ne
# kadar iyi olursa olsun tamamen elenir - ani geri çekilme riski yüksektir.
RSI_OVERBOUGHT_VETO=78

# "Zaten pompalanmış coini kovalama" vetosu: fiyat son PUMP_LOOKBACK_CANDLES
# mumda MAX_RECENT_PUMP_PCT'ten fazla yükseldiyse tamamen elenir - devam eden
# bir hareketin tepesine bahis oynamamak için.
PUMP_LOOKBACK_CANDLES=24
MAX_RECENT_PUMP_PCT=0.15
